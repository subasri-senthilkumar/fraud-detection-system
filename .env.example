# Copy to .env and fill in. NEVER commit .env.

# --- PostgreSQL (used by docker-compose and by the API) ---
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=fraud_db
# For running the API outside Docker against a local Postgres:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# ...or a single URL (takes priority):
# DATABASE_URL=postgresql+psycopg2://fraud_user:password@localhost:5432/fraud_db

# --- Risk bands on the 0-100 score (LOW <= low, MEDIUM <= medium, else HIGH) ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# --- Optional: override the trained fraud/legit decision threshold (0-1) ---
# DECISION_THRESHOLD=0.5

# --- Optional shared-secret auth. If set, clients must send header X-API-Key ---
API_KEY=

# --- Misc ---
LOG_LEVEL=INFO
# MODEL_DIR=./models
# API_URL=http://localhost:8000     # used by the dashboard when run outside Docker
RANDOM_SEED=42
